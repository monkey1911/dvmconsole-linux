<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dvmcli - headless Linux proof of concept for the DVM Desktop Dispatch Console.
    Reuses dvmconsole's Windows-independent sources directly from the extern/dvmconsole submodule.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>dvmcli</AssemblyName>
    <RootNamespace>dvmcli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.4.2</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <DvmConsoleSrc>..\..\extern\dvmconsole\dvmconsole\</DvmConsoleSrc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows-independent dvmconsole sources (AGPL-3.0, DVMProject) -->
    <Compile Include="$(DvmConsoleSrc)Codeplug.cs" Link="dvmconsole\Codeplug.cs" />
    <Compile Include="$(DvmConsoleSrc)AnalogVoiceInversion.cs" Link="dvmconsole\AnalogVoiceInversion.cs" />
    <Compile Include="$(DvmConsoleSrc)ResourceIdentity.cs" Link="dvmconsole\ResourceIdentity.cs" />
    <Compile Include="$(DvmConsoleSrc)VocoderInterop.cs" Link="dvmconsole\VocoderInterop.cs" />
    <Compile Include="$(DvmConsoleSrc)VocoderToneLookupTable.cs" Link="dvmconsole\VocoderToneLookupTable.cs" />
    <Compile Include="$(DvmConsoleSrc)Log.cs" Link="dvmconsole\Log.cs" />
    <Compile Include="$(DvmConsoleSrc)AliasTools.cs" Link="dvmconsole\AliasTools.cs" />
    <Compile Include="$(DvmConsoleSrc)P25ReceiveCrypto.cs" Link="dvmconsole\P25ReceiveCrypto.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extern\dvmconsole\fnecore\fnecore.csproj" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
    <!-- only needed for a [JsonIgnore] attribute in Codeplug.cs; same version as dvmconsole -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- libvocoder.so built by CMake (see build.sh / CI) is copied next to dvmcli when present -->
  <ItemGroup>
    <None Include="..\..\build\native\libvocoder.so" Condition="Exists('..\..\build\native\libvocoder.so')">
      <Link>libvocoder.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
